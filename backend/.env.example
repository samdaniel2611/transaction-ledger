# Port the API listens on
PORT=4000

# MongoDB connection string.
# Multi-document transactions REQUIRE a replica set. The docker-compose.yml in the
# project root starts a single-node replica set reachable at the URI below.
MONGODB_URI=mongodb://127.0.0.1:27017/transaction_ledger?replicaSet=rs0&directConnection=true

# CORS: comma-separated list of allowed origins for the frontend (use * to allow all)
CORS_ORIGIN=http://localhost:4200
